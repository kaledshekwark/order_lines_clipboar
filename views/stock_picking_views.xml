<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_line_clipboard" model="ir.ui.view">
        <field name="name">stock.picking.form.line.clipboard</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_copy_lines_wizard" string="Copy Lines" type="object" invisible="not move_ids"/>
                <button name="action_paste_clipboard_lines" string="Paste Lines" type="object" invisible="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
