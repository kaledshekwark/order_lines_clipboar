<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_line_clipboard" model="ir.ui.view">
        <field name="name">account.move.form.line.clipboard</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_copy_lines_wizard" string="Copy Lines" type="object"
                        invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or not invoice_line_ids"/>
                <button name="action_paste_clipboard_lines" string="Paste Lines" type="object"
                        invisible="move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
