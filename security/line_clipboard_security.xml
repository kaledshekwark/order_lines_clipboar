<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="line_clipboard_own_rule" model="ir.rule">
        <field name="name">Line Clipboard: own lines only</field>
        <field name="model_id" ref="model_line_clipboard"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
